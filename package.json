{
  "name": "demerzel",
  "version": "0.45.0",
  "description": "The Shadow Orchestrator of Your Local Stack Empire",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "bun scripts/patch-swift-package.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test src/lib",
    "tauri": "tauri",
    "sign:macos": "bash scripts/sign-macos.sh",
    "widget:preview": "bunx tauri-plugin-widgets-api preview ./widget.json --size small --watch",
    "widget:install": "bash scripts/sign-macos.sh && rm -rf /Applications/Demerzel.app && cp -R src-tauri/target/debug/bundle/macos/Demerzel.app /Applications/ && bash scripts/sign-macos.sh /Applications/Demerzel.app && open /Applications/Demerzel.app"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@lucide/svelte": "^1.65.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "paneforge": "^1.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.0",
    "tauri-plugin-widgets-api": "^0.6.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.4",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "bun@1.4.4"
}
