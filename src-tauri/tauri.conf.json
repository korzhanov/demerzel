{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demerzel",
  "version": "0.55.6",
  "identifier": "app.demerzel.orchestrator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bash -c 'if [ -f src-tauri/macos-siri/build-siri.sh ]; then S=src-tauri/macos-siri/build-siri.sh; W=src-tauri/macos-widget/build-widget.sh; elif [ -f macos-siri/build-siri.sh ]; then S=macos-siri/build-siri.sh; W=macos-widget/build-widget.sh; else echo \"beforeBundle: build-siri.sh not found (cwd=$(pwd))\" >&2; exit 127; fi; bash \"$S\" && bash \"$W\"'",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Demerzel",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./macos-widget/App.entitlements",
      "files": {
        "PlugIns/DemerzelAppIntents.appex": "./macos-siri/build/Build/Products/Release/DemerzelAppIntents.appex",
        "PlugIns/TauriWidgetExtension.appex": "./macos-widget/build/Build/Products/Release/TauriWidgetExtension.appex"
      }
    }
  },
  "plugins": {
    "widgets": {
      "appGroup": "group.app.demerzel.orchestrator",
      "transport": "widgetContainer",
      "extensionBundleId": "app.demerzel.orchestrator.widgetkit"
    }
  }
}
