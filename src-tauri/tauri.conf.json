{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demerzel",
  "version": "0.24.0",
  "identifier": "app.demerzel.orchestrator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "demerzel-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "widgets": {
      "appGroup": "group.app.demerzel.orchestrator",
      "transport": "widgetContainer",
      "extensionBundleId": "app.demerzel.orchestrator.widgetkit"
    }
  }
}
