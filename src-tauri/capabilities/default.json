{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "widgets:default",
    "notification:default",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    "opener:allow-open-url"
  ]
}
