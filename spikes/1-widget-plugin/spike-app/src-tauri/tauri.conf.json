{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demerzel",
  "version": "0.1.0",
  "identifier": "app.demerzel.orchestrator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build",
    "beforeBundleCommand": "./src-tauri/macos-widget/build-widget.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Demerzel Spike",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./macos-widget/App.entitlements",
      "files": {
        "PlugIns/TauriWidgetExtension.appex": "./macos-widget/build/Build/Products/Release/TauriWidgetExtension.appex"
      }
    }
  },
  "plugins": {
    "widgets": {
      "appGroup": "group.app.demerzel.orchestrator",
      "transport": "widgetContainer",
      "extensionBundleId": "app.demerzel.orchestrator.widgetkit"
    }
  }
}
