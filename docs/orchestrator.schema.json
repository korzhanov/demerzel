{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/korzhanov/demerzel/docs/orchestrator.schema.json",
  "title": "orchestrator.json",
  "description": "Конфиг проекта Demerzel. Лежит в корне проекта или подпроекта.",
  "type": "object",
  "required": ["name", "type"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "type": { "enum": ["app", "parser", "dashboard", "service"] },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dev": { "type": "string" },
        "test": { "type": "string" },
        "migrate": { "type": "string" }
      }
    },
    "ports": {
      "type": "object",
      "required": ["range"],
      "additionalProperties": false,
      "properties": {
        "range": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "minItems": 2,
          "maxItems": 2
        },
        "default": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "tasks": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["todo", "tasks-json", "github"] },
        "repository": {
          "type": "string",
          "description": "owner/name для source=github (#18)"
        },
        "label": {
          "type": "string",
          "description": "Опциональный фильтр метки GitHub Issues"
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
