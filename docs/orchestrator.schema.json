{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/korzhanov/demerzel/docs/orchestrator.schema.json",
  "title": "orchestrator.json",
  "description": "Конфиг проекта Demerzel. Лежит в корне проекта или подпроекта.",
  "type": "object",
  "required": [
    "name",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "app",
        "parser",
        "dashboard",
        "service"
      ]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dev": {
          "type": "string"
        },
        "test": {
          "type": "string"
        },
        "migrate": {
          "type": "string",
          "description": "ORM-агностичная команда миграций. Вызывается dem sync; если нет или пусто — пропуск с сообщением (#43)."
        }
      }
    },
    "ports": {
      "type": "object",
      "required": [
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "range": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "minItems": 2,
          "maxItems": 2
        },
        "default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "tasks": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "todo",
            "tasks-json",
            "github",
            "notion"
          ]
        },
        "repository": {
          "type": "string",
          "description": "owner/name для source=github (#18)"
        },
        "label": {
          "type": "string",
          "description": "Опциональный фильтр метки GitHub Issues"
        },
        "database_id": {
          "type": "string",
          "description": "UUID Notion database для source=notion (#36)"
        },
        "title_property": {
          "type": "string",
          "description": "Имя title-property Notion (по умолчанию Name)"
        },
        "status_property": {
          "type": "string",
          "description": "Имя status/select/checkbox property Notion (по умолчанию Status)"
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pulse": {
      "type": "object",
      "description": "Опрос прогресса проекта (#97): ровно один из command | file. Снимок → summary.json / виджет (#98).",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Shell-команда; stdout = JSON {summary, metrics?, eta_seconds?, state?}"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Относительный путь к JSON пульса в корне проекта (без ..)"
        },
        "interval_secs": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Интервал опроса, секунды"
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Таймаут команды, секунды (для file игнорируется)"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ],
          "not": {
            "required": [
              "file"
            ]
          }
        },
        {
          "required": [
            "file"
          ],
          "not": {
            "required": [
              "command"
            ]
          }
        }
      ]
    },
    "agents": {
      "type": "object",
      "description": "Раннер агента на проект (#95). Перекрывает settings.agents.runner.",
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "gemini",
            "aider",
            "opencode",
            "cursor_agent",
            "cursor-agent",
            "ollama"
          ],
          "description": "CLI-агент по умолчанию для этого проекта"
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "name"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "name",
              "interval_minutes",
              "enabled"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "interval_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 43200
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "default": 3
            }
          }
        }
      }
    }
  }
}
